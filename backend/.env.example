# Copia este archivo a ".env" y llénalo (el ".env" real nunca se comparte ni se sube a git)
PORT=3000

# Base de datos PostgreSQL (Aiven -> "Connection information")
PGHOST=
PGPORT=
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=
PGSSLMODE=require

JWT_SECRET=
GEMINI_API_KEY=

# URL pública de ngrok, SIN "/" al final (se usa para armar las URLs de las imágenes)
BASE_URL=https://obliged-output-dole.ngrok-free.dev

# Opcional: cambia el modelo de Gemini sin tocar código (por defecto gemini-3.8-flash)
# GEMINI_MODEL=
